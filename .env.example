# ---------------------------------------------------------------------------
# GameWiki AI — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Provider: openai | ollama | extractive
#   openai     -> any OpenAI-compatible API (Groq, OpenRouter, OpenAI, ...)
#   ollama     -> local models via Ollama (no API key needed)
#   extractive -> offline fallback, answers by quoting retrieved text (no key)
LLM_PROVIDER=openai

# Free API key: create one at https://console.groq.com (free tier)
# If left empty, the backend automatically answers in offline extractive mode
# (verbatim quotes from the knowledge base) instead of failing.
LLM_API_KEY=

# Model name (default for provider "openai" is llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# Optional: override the API base URL (works with OpenRouter, OpenAI, local servers, ...)
# Groq default:  https://api.groq.com/openai/v1
# OpenAI:        https://api.openai.com/v1
# Ollama:        http://localhost:11434/v1
LLM_API_BASE=

# --- Retrieval -------------------------------------------------------------
# Embedding model (downloaded on first run, cached by sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Minimum cosine similarity (0-1) for a chunk to be passed to the LLM.
# Higher = stricter (fewer hallucination risks), lower = more results.
RETRIEVAL_MIN_SCORE=0.30

# How many top chunks are sent to the LLM
RETRIEVAL_TOP_K=4

# Strength (0-1) of the lexical re-ranking bonus that re-orders the retrieved
# chunks so different phrasings of the same question land on the right section.
# 0 = pure embedding ranking. Only affects ordering, never the threshold above.
RETRIEVAL_LEXICAL_WEIGHT=0.45

# --- Chunking (used at ingestion time) -------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- LLM request tuning ----------------------------------------------------
LLM_TIMEOUT=60
LLM_MAX_TOKENS=700
